FROM python:3.11-slim
RUN useradd -m -u 1000 user
USER user
ENV PATH="/home/user/.local/bin:$PATH" HF_HOME=/home/user/.cache PYTHONUNBUFFERED=1
WORKDIR /home/user
COPY --chown=user requirements-torch.txt .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r requirements-torch.txt
COPY --chown=user app ./app
# Modelo entrenado (la carpeta que genera el notebook). Debe estar junto a este Dockerfile.
# Si aún no lo tienes, borra la línea siguiente y el sistema usará reglas simples.
COPY --chown=user modelo_reclamos ./modelo_reclamos
EXPOSE 8080
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --forwarded-allow-ips='*'"]
